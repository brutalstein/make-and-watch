{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://makewatch.local/schemas/v1/director-operation.schema.json",
  "title": "DirectorOperation",
  "type": "object",
  "required": ["schemaVersion", "operationId", "type", "target", "payload"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "operationId": { "type": "string", "minLength": 8, "maxLength": 128 },
    "type": {
      "type": "string",
      "enum": [
        "scene.update",
        "scene.approve",
        "scene.lock",
        "shot.update",
        "shot.approve",
        "shot.lock",
        "voice.update",
        "camera.update"
      ]
    },
    "target": {
      "type": "object",
      "required": ["entityType", "entityId"],
      "additionalProperties": false,
      "properties": {
        "entityType": { "enum": ["scene", "shot", "character"] },
        "entityId": { "type": "string", "minLength": 1 }
      }
    },
    "payload": { "type": "object" },
    "reason": { "type": "string", "maxLength": 2000 },
    "requestedBy": { "enum": ["user", "director", "system"] }
  }
}
