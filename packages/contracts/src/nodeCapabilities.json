{
  "series": {
    "kind": "series",
    "label": "Series Bible",
    "role": "scope",
    "purpose": "Canonical creative constitution shared by every episode: visual language, language, format, continuity policy and master production defaults.",
    "primaryOutput": "A stable series-level production bible inherited by episodes, scenes and shots.",
    "consumes": [],
    "produces": [
      "episode",
      "character",
      "location"
    ],
    "invariants": [
      "One canonical Series should own an Episode.",
      "Series-wide identity and visual-language changes may invalidate downstream production."
    ],
    "fields": [
      {
        "key": "genre",
        "label": "Genre",
        "type": "text",
        "scope": "creative",
        "description": "Primary dramatic genre.",
        "defaultValue": "cinematic drama"
      },
      {
        "key": "stylePreset",
        "label": "Style preset",
        "type": "enum",
        "scope": "production",
        "description": "Rendering idiom every shot inherits. Selects the prompt scaffold and sampler defaults used by preview generation; visualLanguage refines it.",
        "options": [
          "live-action-cinematic",
          "anime-cinematic",
          "illustration",
          "stylized-3d"
        ],
        "defaultValue": "live-action-cinematic",
        "requiredFor": "preview"
      },
      {
        "key": "visualLanguage",
        "label": "Visual language",
        "type": "multiline",
        "scope": "creative",
        "description": "Canonical lighting, lens, palette, texture and realism rules.",
        "requiredFor": "preview",
        "defaultValue": "cinematic realism, coherent lighting, restrained filmic grade"
      },
      {
        "key": "language",
        "label": "Dialogue language",
        "type": "language",
        "scope": "creative",
        "description": "BCP-47-ish project language used by dialogue and narration.",
        "defaultValue": "tr"
      },
      {
        "key": "targetEpisodeMinutes",
        "label": "Target episode minutes",
        "type": "number",
        "scope": "production",
        "description": "Default finished episode duration.",
        "defaultValue": "20",
        "requiredFor": "final"
      },
      {
        "key": "aspectRatio",
        "label": "Aspect ratio",
        "type": "enum",
        "scope": "production",
        "description": "Master image aspect ratio.",
        "options": [
          "16:9",
          "9:16",
          "1:1",
          "2.39:1"
        ],
        "defaultValue": "16:9"
      },
      {
        "key": "fps",
        "label": "Master FPS",
        "type": "number",
        "scope": "production",
        "description": "Final composition frame rate.",
        "defaultValue": "24",
        "requiredFor": "final"
      },
      {
        "key": "masterSeed",
        "label": "Master seed",
        "type": "seed",
        "scope": "production",
        "description": "Stable deterministic seed namespace for derived shot seeds.",
        "defaultValue": "1337"
      },
      {
        "key": "contentRating",
        "label": "Content rating",
        "type": "text",
        "scope": "creative",
        "description": "Creative safety/rating target used during planning.",
        "defaultValue": "general"
      },
      {
        "key": "audioStyle",
        "label": "Audio style",
        "type": "multiline",
        "scope": "creative",
        "description": "Global dialogue, music, ambience and loudness direction.",
        "defaultValue": "cinematic dialogue, restrained score, natural ambience"
      }
    ]
  },
  "episode": {
    "kind": "episode",
    "label": "Episode Master",
    "role": "scope",
    "purpose": "One renderable story deliverable. Owns scene ordering, target runtime and the final composition/export contract.",
    "primaryOutput": "One assembled episode master plus render manifest.",
    "consumes": [
      "series"
    ],
    "produces": [
      "scene",
      "generation",
      "asset"
    ],
    "invariants": [
      "An Episode belongs to exactly one Series.",
      "Final duration is derived from scene/shot/audio timing rather than a single long model generation."
    ],
    "fields": [
      {
        "key": "episodeNumber",
        "label": "Episode number",
        "type": "number",
        "scope": "creative",
        "description": "Human ordering within the Series.",
        "defaultValue": "1"
      },
      {
        "key": "targetDurationSeconds",
        "label": "Target duration",
        "type": "duration",
        "scope": "production",
        "description": "Desired final runtime in seconds.",
        "defaultValue": "1200",
        "requiredFor": "final"
      },
      {
        "key": "synopsis",
        "label": "Synopsis",
        "type": "multiline",
        "scope": "creative",
        "description": "Episode-level story summary."
      },
      {
        "key": "dramaticArc",
        "label": "Dramatic arc",
        "type": "multiline",
        "scope": "creative",
        "description": "Setup, escalation, climax and resolution intent."
      },
      {
        "key": "pace",
        "label": "Pace",
        "type": "enum",
        "scope": "creative",
        "description": "Global edit rhythm.",
        "options": [
          "slow",
          "measured",
          "balanced",
          "fast",
          "kinetic"
        ],
        "defaultValue": "balanced"
      },
      {
        "key": "renderProfile",
        "label": "Render profile",
        "type": "enum",
        "scope": "production",
        "description": "Master delivery profile.",
        "options": [
          "preview-720p",
          "master-1080p",
          "master-1440p",
          "master-4k"
        ],
        "defaultValue": "preview-720p"
      },
      {
        "key": "soundtrackPolicy",
        "label": "Soundtrack policy",
        "type": "multiline",
        "scope": "production",
        "description": "How score, ambience and dialogue are balanced and reused."
      },
      {
        "key": "subtitlePolicy",
        "label": "Subtitle policy",
        "type": "enum",
        "scope": "production",
        "description": "Subtitle output behavior.",
        "options": [
          "none",
          "burn-in",
          "sidecar",
          "both"
        ],
        "defaultValue": "sidecar"
      }
    ]
  },
  "scene": {
    "kind": "scene",
    "label": "Scene",
    "role": "production-unit",
    "purpose": "Narrative and continuity block. Converts one dramatic beat into ordered shots plus dialogue, ambience and transition intent.",
    "primaryOutput": "A scene package containing shot media, timed audio and scene-level continuity state.",
    "consumes": [
      "episode",
      "character",
      "location",
      "audio",
      "asset"
    ],
    "produces": [
      "shot",
      "audio",
      "generation",
      "asset"
    ],
    "invariants": [
      "A final Scene has at least one Shot.",
      "Scene ownership of Shots must be unambiguous.",
      "Location and Character dependencies are semantic anchors, not copied prompt text."
    ],
    "fields": [
      {
        "key": "index",
        "label": "Scene index",
        "type": "number",
        "scope": "creative",
        "description": "Scene ordering inside the Episode.",
        "defaultValue": "1"
      },
      {
        "key": "durationSeconds",
        "label": "Target duration",
        "type": "duration",
        "scope": "production",
        "description": "Scene timing budget.",
        "defaultValue": "45",
        "requiredFor": "final"
      },
      {
        "key": "summary",
        "label": "Scene summary",
        "type": "multiline",
        "scope": "creative",
        "description": "What visibly/narratively happens.",
        "requiredFor": "preview"
      },
      {
        "key": "dramaticGoal",
        "label": "Dramatic goal",
        "type": "multiline",
        "scope": "creative",
        "description": "What must change by the end of the Scene."
      },
      {
        "key": "beat",
        "label": "Story beat",
        "type": "text",
        "scope": "creative",
        "description": "Compact beat label such as reveal, confrontation or release."
      },
      {
        "key": "pace",
        "label": "Scene pace",
        "type": "enum",
        "scope": "creative",
        "description": "Scene-level edit tempo.",
        "options": [
          "slow",
          "measured",
          "balanced",
          "fast",
          "kinetic"
        ],
        "defaultValue": "balanced"
      },
      {
        "key": "timeOfDay",
        "label": "Time of day",
        "type": "text",
        "scope": "creative",
        "description": "Scene-local time/lighting override."
      },
      {
        "key": "weather",
        "label": "Weather",
        "type": "text",
        "scope": "creative",
        "description": "Scene-local environment condition."
      },
      {
        "key": "transitionIn",
        "label": "Transition in",
        "type": "enum",
        "scope": "production",
        "description": "Composition transition entering the Scene.",
        "options": [
          "cut",
          "fade",
          "dip-black",
          "dissolve",
          "match-cut"
        ],
        "defaultValue": "cut"
      },
      {
        "key": "transitionOut",
        "label": "Transition out",
        "type": "enum",
        "scope": "production",
        "description": "Composition transition leaving the Scene.",
        "options": [
          "cut",
          "fade",
          "dip-black",
          "dissolve",
          "match-cut"
        ],
        "defaultValue": "cut"
      },
      {
        "key": "generationPolicy",
        "label": "Generation policy",
        "type": "enum",
        "scope": "production",
        "description": "Default strategy selector for child Shots.",
        "options": [
          "hybrid",
          "mostly-stills",
          "mostly-i2v",
          "full-video"
        ],
        "defaultValue": "hybrid"
      },
      {
        "key": "dialogueBudgetSeconds",
        "label": "Dialogue budget",
        "type": "duration",
        "scope": "production",
        "description": "Approximate spoken-content budget used for pacing."
      }
    ]
  },
  "shot": {
    "kind": "shot",
    "label": "Shot",
    "role": "production-unit",
    "purpose": "Smallest visual editorial unit. It is the contract sent to image/video generation and later placed on the episode timeline.",
    "primaryOutput": "One time-bounded visual clip or animated still with deterministic provenance.",
    "consumes": [
      "scene",
      "character",
      "location",
      "asset",
      "audio"
    ],
    "produces": [
      "generation",
      "asset"
    ],
    "invariants": [
      "A final Shot has a positive duration.",
      "Generation strategy is explicit.",
      "Character/location continuity is referenced through dependencies."
    ],
    "fields": [
      {
        "key": "index",
        "label": "Shot index",
        "type": "number",
        "scope": "creative",
        "description": "Ordering inside the owning Scene.",
        "defaultValue": "1"
      },
      {
        "key": "durationSeconds",
        "label": "Duration",
        "type": "duration",
        "scope": "production",
        "description": "Editorial duration in seconds.",
        "defaultValue": "5",
        "requiredFor": "final"
      },
      {
        "key": "purpose",
        "label": "Shot purpose",
        "type": "text",
        "scope": "creative",
        "description": "Narrative reason the Shot exists: establish, reaction, reveal, action, insert, etc."
      },
      {
        "key": "framing",
        "label": "Framing",
        "type": "enum",
        "scope": "creative",
        "description": "Camera framing.",
        "options": [
          "extreme-wide",
          "wide",
          "medium-wide",
          "medium",
          "medium-close",
          "close-up",
          "extreme-close-up",
          "insert"
        ],
        "defaultValue": "medium"
      },
      {
        "key": "camera",
        "label": "Camera movement",
        "type": "text",
        "scope": "creative",
        "description": "Static, handheld, dolly, pan, tilt, orbit, push-in, rack-focus, etc.",
        "defaultValue": "static"
      },
      {
        "key": "subjectAction",
        "label": "Subject action",
        "type": "multiline",
        "scope": "creative",
        "description": "Visible action that must occur during the Shot."
      },
      {
        "key": "motionLevel",
        "label": "Motion level",
        "type": "enum",
        "scope": "production",
        "description": "Motion complexity used to choose still-motion vs I2V/video.",
        "options": [
          "none",
          "low",
          "medium",
          "high"
        ],
        "defaultValue": "low"
      },
      {
        "key": "generationStrategy",
        "label": "Generation strategy",
        "type": "enum",
        "scope": "production",
        "description": "Concrete media synthesis mode.",
        "options": [
          "STILL_MOTION",
          "T2I",
          "I2V",
          "VIDEO",
          "COMPOSITE"
        ],
        "defaultValue": "STILL_MOTION",
        "requiredFor": "preview"
      },
      {
        "key": "qualityTier",
        "label": "Quality tier",
        "type": "enum",
        "scope": "production",
        "description": "Controls steps/resolution/retries.",
        "options": [
          "draft",
          "preview",
          "final"
        ],
        "defaultValue": "preview"
      },
      {
        "key": "continuityPriority",
        "label": "Continuity priority",
        "type": "enum",
        "scope": "production",
        "description": "How aggressively identity/location anchors constrain regeneration.",
        "options": [
          "low",
          "medium",
          "high",
          "critical"
        ],
        "defaultValue": "high"
      },
      {
        "key": "seed",
        "label": "Shot seed",
        "type": "seed",
        "scope": "production",
        "description": "Explicit deterministic seed. If empty it is derived from the Series master seed and Shot id."
      },
      {
        "key": "promptOverride",
        "label": "Prompt override",
        "type": "multiline",
        "scope": "creative",
        "description": "Optional user-authored visual additions without replacing canonical anchors."
      },
      {
        "key": "negativePrompt",
        "label": "Negative prompt",
        "type": "multiline",
        "scope": "production",
        "description": "Shot-specific exclusions."
      },
      {
        "key": "transitionOut",
        "label": "Transition out",
        "type": "enum",
        "scope": "production",
        "description": "Editorial transition after this Shot.",
        "options": [
          "cut",
          "fade",
          "dissolve",
          "match-cut"
        ],
        "defaultValue": "cut"
      },
      {
        "key": "reusePolicy",
        "label": "Reuse policy",
        "type": "enum",
        "scope": "production",
        "description": "Whether a generated result may be reused as an establishing/loop asset.",
        "options": [
          "unique",
          "allow-reuse",
          "prefer-reuse"
        ],
        "defaultValue": "unique"
      }
    ]
  },
  "character": {
    "kind": "character",
    "label": "Character Anchor",
    "role": "creative-anchor",
    "purpose": "Canonical identity and performance anchor shared across every Scene and Shot where the Character appears.",
    "primaryOutput": "Stable visual identity, voice identity and performance constraints.",
    "consumes": [
      "asset"
    ],
    "produces": [
      "shot",
      "audio",
      "generation"
    ],
    "invariants": [
      "Identity anchors are shared, not copied per episode.",
      "Locked Character changes require explicit unlock and may invalidate every dependent Shot/Audio node."
    ],
    "fields": [
      {
        "key": "role",
        "label": "Role",
        "type": "text",
        "scope": "creative",
        "description": "Lead, supporting, antagonist, narrator, etc."
      },
      {
        "key": "description",
        "label": "Character description",
        "type": "multiline",
        "scope": "creative",
        "description": "Canonical human-readable identity description."
      },
      {
        "key": "appearancePrompt",
        "label": "Appearance anchor",
        "type": "multiline",
        "scope": "creative",
        "description": "Stable generation-facing appearance description.",
        "requiredFor": "preview"
      },
      {
        "key": "wardrobe",
        "label": "Default wardrobe",
        "type": "multiline",
        "scope": "creative",
        "description": "Canonical wardrobe and allowed variations."
      },
      {
        "key": "agePresentation",
        "label": "Age presentation",
        "type": "text",
        "scope": "creative",
        "description": "Visual age range/presentation when relevant."
      },
      {
        "key": "performanceStyle",
        "label": "Performance style",
        "type": "multiline",
        "scope": "creative",
        "description": "Gesture, expression and acting direction."
      },
      {
        "key": "identitySeed",
        "label": "Identity seed",
        "type": "seed",
        "scope": "production",
        "description": "Stable seed namespace for identity references."
      },
      {
        "key": "voiceProvider",
        "label": "Voice provider",
        "type": "enum",
        "scope": "production",
        "description": "Preferred voice synthesis provider.",
        "options": [
          "chatterbox",
          "piper",
          "external"
        ],
        "defaultValue": "chatterbox"
      },
      {
        "key": "voiceLanguage",
        "label": "Voice language",
        "type": "language",
        "scope": "production",
        "description": "Character-specific voice language override."
      },
      {
        "key": "voiceReferenceAsset",
        "label": "Voice reference asset",
        "type": "path",
        "scope": "production",
        "description": "Approved short reference audio asset for voice conditioning."
      },
      {
        "key": "voiceExaggeration",
        "label": "Voice expression",
        "type": "number",
        "scope": "production",
        "description": "Provider-neutral expression intensity.",
        "defaultValue": "0.5"
      },
      {
        "key": "voiceCfg",
        "label": "Voice CFG",
        "type": "number",
        "scope": "production",
        "description": "Provider-neutral voice similarity/accent guidance.",
        "defaultValue": "0.5"
      }
    ]
  },
  "location": {
